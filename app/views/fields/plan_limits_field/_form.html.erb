<div class="field-unit__label">
  <%= f.label field.attribute %>
</div>
<div class="field-unit__field">
  <p class="text-sm text-slate-600 mb-2">Leave a box empty for unlimited.</p>
  <% Plan::LIMIT_KEYS.each do |key| %>
    <div class="flex items-center gap-2 mb-1">
      <label class="w-56 text-sm" for="plan_limits_<%= key %>"><%= PlanLimitsField.label(key) %></label>
      <%= number_field_tag "plan[limits][#{key}]", field.values[key], min: 0, id: "plan_limits_#{key}", class: 'w-40' %>
    </div>
  <% end %>
  <% Plan::FEATURE_KEYS.each do |key| %>
    <div class="flex items-center gap-2 mb-1">
      <%= hidden_field_tag "plan[limits][#{key}]", '0', id: nil %>
      <%= check_box_tag "plan[limits][#{key}]", '1', field.values[key] != false, id: "plan_limits_#{key}" %>
      <label class="text-sm" for="plan_limits_<%= key %>"><%= PlanLimitsField.label(key) %></label>
    </div>
  <% end %>
  <div class="mt-3">
    <label class="text-sm" for="plan_limits_extra">Extra limits (one per line, like <code>broadcast_lists=5</code>)</label>
    <%= text_area_tag 'plan[limits_extra]', field.extra_text, rows: 3, id: 'plan_limits_extra', class: 'w-full' %>
  </div>
</div>
